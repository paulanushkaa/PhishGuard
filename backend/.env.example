# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore).

# Required. Your Google Cloud API key with the Web Risk API enabled.
# https://docs.cloud.google.com/web-risk/docs/lookup-api
GOOGLE_WEB_RISK_API_KEY=

# Port the backend listens on locally. Most hosting platforms (Cloud Run,
# Render, etc.) set PORT for you automatically - leave unset in production.
PORT=8787

# development | production
NODE_ENV=development

# Comma-separated list of exact allowed CORS origins for production, e.g.
# ALLOWED_ORIGINS=chrome-extension://<your-published-extension-id>
# Leave unset in development - localhost and any chrome-extension:// origin
# are allowed automatically when NODE_ENV is not "production" (see server.js).
ALLOWED_ORIGINS=

# Optional rate-limit tuning (defaults: 60 requests per 60000ms per IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
